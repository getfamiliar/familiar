{
    "name": "@getfamiliar/plugin-memory",
    "type": "module",
    "version": "0.0.1",
    "description": "Familiar plugin: long-term memory for the agent — wiki index in postgres (pg_trgm), memory_search, memory_datesearch and memory_save, plus maintenance: lint, review, split of oversized files and weekly dedup.",
    "publishConfig": {
        "access": "public"
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "familiar": {
        "plugin": true,
        "bundled": true
    },
    "files": [
        "build",
        "!build/Eval*",
        "workspace-template"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc",
        "format": "biome format --write --config-path ../.. src/",
        "format:check": "biome format --config-path ../.. src/",
        "lint": "biome lint --config-path ../.. src/",
        "check": "biome check --config-path ../.. src/",
        "test": "tsx --test 'src/**/*.test.ts'"
    },
    "license": "MIT",
    "dependencies": {
        "@getfamiliar/shared": "*",
        "citty": "^0.1.6",
        "croner": "^10.0.1",
        "yaml": "^2.8.4"
    },
    "devDependencies": {
        "@ai-sdk/openai": "^4.0.109",
        "@ai-sdk/openai-compatible": "^3.0.85",
        "@biomejs/biome": "^2.4.12",
        "@types/node": "^22",
        "ai": "^7.0.163",
        "typescript": "^6.0.3",
        "zod": "^4.6.7"
    }
}
