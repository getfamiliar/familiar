{
    "name": "@getfamiliar/plugin-gpt-voice",
    "type": "module",
    "version": "0.0.1",
    "description": "Familiar plugin: talk to the assistant by voice (OpenAI GPT-Live), in the web UI and later by phone.",
    "publishConfig": {
        "access": "public"
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "familiar": {
        "plugin": true,
        "bundled": true
    },
    "files": [
        "build",
        "workspace-template"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.app.json && vite build",
        "format": "biome format --write src/",
        "format:check": "biome format src/",
        "lint": "biome lint src/",
        "check": "biome check src/",
        "test": "tsx --test 'src/**/*.test.ts'"
    },
    "license": "MIT",
    "dependencies": {
        "@ai-sdk/openai": "^4.0.109",
        "@getfamiliar/shared": "*",
        "ai": "^7.0.163",
        "hono": "^4.13.16",
        "ws": "^8.22.1",
        "yaml": "^2.8.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.12",
        "@getfamiliar/avatar": "*",
        "@shadcn/react": "^0.3.1",
        "@tailwindcss/vite": "^4.3.4",
        "@types/node": "^22",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^6.2.1",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "lucide-react": "^1.69.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.6"
    }
}
