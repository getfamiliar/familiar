{
    "name": "@getfamiliar/plugin-tesla",
    "type": "module",
    "version": "0.0.1",
    "description": "Familiar plugin: read-only Tesla Owner API access — vehicle state, location, and Supercharger / Premium Connectivity invoice PDFs.",
    "publishConfig": {
        "access": "public"
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "familiar": {
        "plugin": true
    },
    "files": [
        "build",
        "workspace-template"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc",
        "format": "biome format --write --config-path ../.. src/",
        "format:check": "biome format --config-path ../.. src/",
        "lint": "biome lint --config-path ../.. src/",
        "check": "biome check --config-path ../.. src/",
        "test": "tsx --test 'src/**/*.test.ts'"
    },
    "license": "MIT",
    "dependencies": {
        "@getfamiliar/shared": "*",
        "@inquirer/prompts": "^7.0.0",
        "citty": "^0.1.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.12",
        "@types/node": "^25.6.0",
        "typescript": "^6.0.3"
    }
}
