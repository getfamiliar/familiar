{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./build",
        "rootDir": "./src/host",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "types": ["node"]
    },
    "include": ["src/host/**/*"],
    "exclude": ["node_modules", "build", "src/host/**/*.test.ts"]
}
