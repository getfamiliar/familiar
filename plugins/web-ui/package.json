{
    "name": "@getfamiliar/plugin-web-ui",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "description": "Familiar plugin: the web UI (React + shadcn/ui), served by the core webserver behind its authentication.",
    "publishConfig": {
        "access": "public"
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "familiar": {
        "plugin": true
    },
    "files": [
        "build"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.app.json && vite build",
        "format": "biome format --write src/",
        "format:check": "biome format src/",
        "lint": "biome lint src/",
        "check": "biome check src/",
        "test": "tsx --test 'src/host/**/*.test.ts'"
    },
    "license": "MIT",
    "dependencies": {
        "@getfamiliar/shared": "*",
        "@hono/node-server": "^1.19.14",
        "hono": "^4.13.16"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.12",
        "@fontsource-variable/geist": "^5.3.0",
        "@tailwindcss/vite": "^4.3.4",
        "@types/node": "^22",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "lucide-react": "^1.69.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.6"
    }
}
