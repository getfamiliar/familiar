{
    "name": "@getfamiliar/plugin-tailscale",
    "type": "module",
    "version": "0.0.1",
    "description": "Familiar plugin: publishes the familiar web UI in your tailnet via a dedicated userspace Tailscale node (HTTPS only, nothing else of the host).",
    "publishConfig": {
        "access": "public"
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "familiar": {
        "plugin": true
    },
    "files": [
        "build"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc",
        "format": "biome format --write --config-path ../.. src/",
        "format:check": "biome format --config-path ../.. src/",
        "lint": "biome lint --config-path ../.. src/",
        "check": "biome check --config-path ../.. src/",
        "test": "tsx --test 'src/**/*.test.ts'"
    },
    "license": "MIT",
    "dependencies": {
        "@getfamiliar/shared": "*",
        "citty": "^0.1.6",
        "ora": "^8.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.12",
        "@types/node": "^22",
        "typescript": "^6.0.3"
    }
}
