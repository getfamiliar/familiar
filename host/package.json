{
  "name": "@getfamiliar/host",
  "type": "module",
  "version": "0.0.1",
  "description": "Familiar — host application.",
  "publishConfig": {
    "access": "public"
  },
  "main": "build/index.js",
  "files": [
    "build",
    "template",
    "workspace-template",
    "workspace-updates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "format": "biome format --write --config-path .. src/",
    "format:check": "biome format --config-path .. src/",
    "lint": "biome lint --config-path .. src/",
    "check": "biome check --config-path .. src/",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@getfamiliar/shared": "*",
    "@hono/node-server": "^1.19.14",
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^3.6.0",
    "citty": "^0.1.6",
    "croner": "^10.0.1",
    "diff": "^8.0.4",
    "friendly-node-cron": "^1.5.0",
    "hono": "^4.13.16",
    "isomorphic-git": "^1.44.11",
    "luxon": "^3.7.2",
    "node-diff3": "^3.2.1",
    "ora": "^8.1.0",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "pino-roll": "^3.1.0",
    "ws": "^8.22.1",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3"
  }
}
