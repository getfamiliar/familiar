{
  "name": "@getfamiliar/container",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Familiar — long-running agent container that consumes events from the bus-state postgres. Delivered as the familiar-agent Docker image, not published to npm.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "format": "biome format --write --config-path .. src/",
    "format:check": "biome format --config-path .. src/",
    "lint": "biome lint --config-path .. src/",
    "check": "biome check --config-path .. src/",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/deepseek": "^3.0.80",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/groq": "^4.0.77",
    "@ai-sdk/mcp": "^2.0.91",
    "@ai-sdk/mistral": "^4.0.80",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@ai-sdk/provider": "^4.0.36",
    "@ai-sdk/xai": "^5.0.39",
    "@getfamiliar/shared": "*",
    "ai": "^7.0.163",
    "nodemon": "^3.1.7",
    "pino": "^9.14.0",
    "tsx": "^4.20.4",
    "typescript": "^6.0.3",
    "yaml": "^2.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0"
  }
}
